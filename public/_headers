# Caching for static files on Cloudflare Pages. Security headers are added to every response by
# functions/_middleware.ts instead, because Functions responses don't use this file.

# Built JS/CSS/fonts have a content hash in their names, so they never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and logos keep their names when replaced: cache for a day, then check for a newer copy.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
