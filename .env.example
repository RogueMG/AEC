# Build-time settings for the website (Vite). Only VITE_* values reach the browser,
# so never put a secret here.
#
# Local use: copy this to .env.development.local (for `npm run dev`) and
# .env.localtest.local (for `npm run build:local`, `npm run dev:full` and `npm run dev:cf`).
# Both are git-ignored. `npm run build` (the real production build) reads neither, so a test key
# can never end up on the live site.

# Cloudflare Turnstile site key (public). The value below is Cloudflare's test key that
# always passes, for local work only.
# Production: the real site key is in the committed .env.production (it's public), and the
# matching TURNSTILE_SECRET is a Pages *secret* in both Production and Preview (see .dev.vars.example).
# Set both or neither: if the secret is set but the site key isn't, every enquiry is rejected.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
