{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:cf": "tsc -b && vite build --mode cloudflare",
    "dev:cf": "npm run build:cf && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply aec-db --local",
    "db:seed:local": "node scripts/seed-sql.ts && wrangler d1 execute aec-db --local --file=seed/seed.sql",
    "dev:api": "wrangler pages dev --port 8788 --ip 127.0.0.1",
    "dev:full": "npm run build:cf && concurrently -k -n api,site -c blue,green \"npm:dev:api\" \"vite\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.163.0"
  }
}
